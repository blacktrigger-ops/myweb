<div>
<label>Title</label>
<br>
<input type="text" name="title" value="<%= book.title %>" required>
</div>
<br>
<div>
<label> Author </label>
<br>
<select name="author">
    <% authors.forEach(author => { %>
       <% if(author.id === book.author) {%> 
       <option selected label="<%= author.name %>" value="<%= author.id %>"></option>
        <% }else {%>
         <option label="<%= author.name %>" value="<%= author.id %>"></option>
    <% } %>

  <% }) %>

</select>
</div>
<br>
<div>
<label> Publish Date </label>
<br>
<input type="date" name="publishDate" 
             value="<%= book.publishDate == null ? '': book.publishDate.toISOString().split('T')%>">
</div>
<br>
<div>
<label> Page Count</label>
<br>
<input type="number" name="pageCount" min="1" value="<%= book.pageCount %>" required>
</div>
<br>
<div>
<label> Cover </label>
<br>
<input type="file" name="cover" class="filepond">
</div>
<br>
<div>
<label> Description </label>
<br>
<textarea name="description"><%= book.description %></textarea>
</div>